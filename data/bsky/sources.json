    { "id": "github-new-repos", "enabled": true, "params": { "days": 90, "minStars": 300, "topics": ["self-hosted", "saas", "productivity", "automation", "browser-extension"], "requireHomepage": true, "perPage": 50 } },
    { "id": "ledger", "enabled": true, "params": {} },
    { "id": "fazier", "enabled": true, "params": { "minUpvotes": 20 } },
